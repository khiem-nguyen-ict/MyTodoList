@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Edit task";
}

<h1 class="display-4">Edit task</h1>

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        @* The form posts back to /Edit/{id} — the route value binds to the id parameter *@
        <form method="post">
            <div class="input-group mb-2">
                <label asp-for="Title" class="visually-hidden">Task title</label>
                <input asp-for="Title" class="form-control" placeholder="What needs to be done?" autocomplete="off" />
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
            <span asp-validation-for="Title" class="text-danger d-block mb-4"></span>
            <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
